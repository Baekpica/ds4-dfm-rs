# Environment for h3-server-rs.service. Copy to ~/.config/h3-server-rs/env
# and edit. H3_BIND=0.0.0.0:8090 makes the surface reachable from the LAN;
# there is no authentication in the local v1 contract, so any host on that
# network can queue renders.
H3_BIND=0.0.0.0:8090
H3_OUT_DIR=/home/leandro/h3-api/out
H3_MODEL_DIR=/mnt/h3-artifacts/MiniMax-H3
# Denoise evaluations: 20 is the release quality, 2 is the smoke test.
H3_STEPS=20
H3_MAX_JOBS=4
H3_TIMEOUT_SECS=3600
