# MiniMax-H3 local v1 video API as a user service.
#
# Install (on the Spark, no root needed):
#   mkdir -p ~/.config/systemd/user ~/.config/h3-server-rs
#   cp h3-server-rs.service ~/.config/systemd/user/
#   cp env.example ~/.config/h3-server-rs/env
#   systemctl --user daemon-reload
#   systemctl --user enable --now h3-server-rs
#   loginctl enable-linger "$USER"     # keep it running after logout
#
# The unit is a template: every path and value comes from the environment
# file, so the same file works on another host.
[Unit]
Description=MiniMax-H3 local v1 video API (h3-server-rs)
Documentation=file:%h/ds4-h3-port/docs/minimax-h3/local-v1-contract.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/h3-server-rs/env
ExecStart=%h/ds4-h3-port/h3-server-rs --bind ${H3_BIND} --out-dir ${H3_OUT_DIR} --model-dir ${H3_MODEL_DIR} --steps ${H3_STEPS} --max-jobs ${H3_MAX_JOBS} --timeout-secs ${H3_TIMEOUT_SECS}
Restart=on-failure
RestartSec=5
# One GPU: the server renders one clip at a time and queues the rest, so a
# restart mid-render loses that clip and nothing else.

[Install]
WantedBy=default.target
